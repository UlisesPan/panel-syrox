# Base de datos (con `pnpm db:up` se levanta este Postgres vía Docker)
DATABASE_URL="postgresql://panel:panel@localhost:5432/panel?schema=public"
# Conexiones máximas del pool (opcional, default 10)
DATABASE_POOL_MAX=10

# Servidor
PORT=4000
# Orígenes permitidos para CORS (separados por coma). En producción el front proxy-ea /api, así que es opcional.
CORS_ORIGINS="http://localhost:3000"

# Auth
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-32+-caracteres"
# Duración de la sesión normal y con "Mantener sesión iniciada"
JWT_EXPIRES_IN="8h"
JWT_REMEMBER_EXPIRES_IN="30d"

# Usuario admin que crea el seed
SEED_ADMIN_EMAIL="admin@panel.com"
SEED_ADMIN_PASSWORD="Admin123!"

# URL pública del panel (links de los mails). Si falta se usa el primer origen de CORS_ORIGINS.
APP_URL="http://localhost:3000"
# Mails con Brevo (https://app.brevo.com → SMTP & API → API keys). Sin API key el link se escribe en el log.
# MAIL_FROM_EMAIL tiene que ser un remitente verificado en Brevo.
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Panel Admin"
# Color, logo, moneda y locale de los mails (por defecto el logo es APP_URL/brand/logo.png)
MAIL_BRAND_COLOR="#e11d48"
MAIL_LOGO_URL=""
CURRENCY="MXN"
LOCALE="es-MX"

# Imágenes de productos con Cloudinary (https://console.cloudinary.com → Settings → API Keys).
# Sin estas variables las imágenes se cargan por URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
